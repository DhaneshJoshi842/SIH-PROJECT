<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= theme.title %> - Herbal Garden
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f8ff;
            margin: 0;
            padding: 0;
            background-image: url('https://wallpaperaccess.com/full/773426.jpg');
            background-size: cover;
        }

        .container {
            width: 80%;
            margin: 50px auto;
            padding: 20px;
        }

        .theme-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .theme-header h1 {
            margin: 0;
            color: #1b2e2e;
        }

        .sub_cards {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        .card {
            width: 18rem;
            transition: transform 0.3s, box-shadow 0.3s;
            background-color: #b9e7d2;
            position: relative;
            padding: 10px;
        }

        .card-img-top {
            margin: auto;
            margin-top: 10px;
            width: 90%;
            border-radius: 8px;
            height: 150px;
        }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .theme-description {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.2rem;
            color: rgb(239, 220, 220);
        }

        button {
            background-color: #40916c;
            border: none;
            padding: 8px 16px;
            border-radius: 5px;
            color: white;
            text-decoration: none;
            transition: background-color 0.3s ease;
            display: flex;
            margin: auto;
            height: 40px;

        }

        button:hover {
            background-color: #1b4332;
        }

        .stop-btn {
            background-color: red;
        }

        .stop-btn:hover {
            background-color: darkred;
        }

        .like-btn {
            height: 40px;
            position: absolute;
            right: 0px;
        }

        .liked {
            color: red;
        }

        .two_btns {
            display: flex;
            justify-content: space-between;

        }
    </style>
</head>

<body>
    <div class="container">
        <div class="theme-header">
            <h1>
                <u>
                    <%= theme.title %>
                </u>
            </h1>
        </div>
        <div class="theme-description">
            <p>
                <%= theme.description %>
            </p>
        </div>

        <hr>
        <div class="sub_cards">
            <% theme.herbs.forEach(herb=> { %>
                <div class="card">
                    <img src="<%= herb.image %>" class="card-img-top" alt="<%= herb.botanicalName %>">
                    <div class="card-body">
                        <h4 class="card-title" style="text-align: center;">
                            <%= herb.commonNames[0] %>
                        </h4>
                    </div>
                    <form method="get" action="/searchData">
                        <input type="hidden" name="herb_name" value="<%= herb.commonNames[0] %>">
                        <button type="submit">View More</button>
                    </form>
                </div>
                <% }) %>
        </div>
    </div>

    <script>
        let currentUtterance = null;
        let isSpeaking = false;

        function speakHerb(commonNames, botanicalName, habitat, medicinalUses, cultivationMethods) {
            if (currentUtterance) {
                speechSynthesis.cancel();
                currentUtterance = null;
                isSpeaking = false;
            }

            currentUtterance = new SpeechSynthesisUtterance(
                `Common Names: ${commonNames}. Botanical Name: ${botanicalName}. Habitat: ${habitat}. Medicinal Uses: ${medicinalUses}. Cultivation Methods: ${cultivationMethods}.`
            );
            currentUtterance.voice = speechSynthesis.getVoices().find(voice => voice.name === 'Google US English');
            speechSynthesis.speak(currentUtterance);
            isSpeaking = true;
        }

        function toggleSpeech(commonNames, botanicalName, habitat, medicinalUses, cultivationMethods, button) {
            if (isSpeaking) {
                speechSynthesis.cancel();
                button.textContent = 'Listen';
                button.classList.remove('stop-btn');
                isSpeaking = false;
            } else {
                speakHerb(commonNames, botanicalName, habitat, medicinalUses, cultivationMethods);
                button.textContent = 'Stop';
                button.classList.add('stop-btn');
            }
        }

        function toggleLike(themeId, herbId, button) {
            const isLiked = button.classList.contains('liked');
            fetch(`/fav/${themeId}/${herbId}`, {
                method: isLiked ? 'DELETE' : 'POST'
            })
                .then(response => response.text())
                .then(data => {
                    if (!isLiked) {
                        button.classList.add('liked');
                    } else {
                        button.classList.remove('liked');
                    }
                })
                .catch(error => console.error('Error:', error));
        }
    </script>
</body>

</html>