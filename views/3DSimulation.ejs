<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            background-image: url("https://wallpaperaccess.com/full/773426.jpg");
            background-size: cover;
        }

        .main {

            margin: auto;
            margin-top: 8%;
            background: transparent;
            border: 5px solid rgb(152, 212, 165);
            border-radius: 5px;
        }

        video {
            height: 300px;
            width: 100%;
            margin-top: 30px;

        }
    </style>
</head>

<body>

    <div style="height: 450px; width: 850px;" class="main">
        <div>
            <video src='<%= ele.vidio %>' autoplay loop muted width="100%" height="100%">
                Your browser does not support the video tag.
            </video>
        </div>
        <div>
            <h2 style="color: azure; text-align: center;">
                <u>
                    <%=ele.commonNames[0]%>
                </u>
            </h2>
            <h4 style="color: rgb(249, 251, 242); font-size: medium; text-align: center;">
                <%=ele. medicinalUses+ " " +ele.cultivationMethods%>
            </h4>
        </div>

    </div>


</body>

</html>